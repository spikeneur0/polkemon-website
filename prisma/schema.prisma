generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String      @db.Text
  price         Int // cents
  compareAtPrice Int?       // cents
  category      String
  images        String[]
  isSoldOut     Boolean     @default(false)
  isFeatured    Boolean     @default(false)
  featuredOrder Int?
  sku           String?
  quantity      Int         @default(0)
  tags          String[]
  isPublished   Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Market Pricing
  marketPriceEnabled     Boolean   @default(false)
  marketPrice            Int?      // last fetched market price in cents
  marketPriceLastUpdated DateTime?
  marketPriceMarkup      Decimal   @default(0) @db.Decimal(5, 2)
  marketPriceCondition   String    @default("Near Mint")
  marketPricePrinting    String    @default("Holofoil")
  manualPrice            Int?      // preserved manual price for fallback (cents)
  tcgplayerId            String?
  justTcgId              String?
  linkedCardName         String?   // display name of linked card

  orderItems OrderItem[]

  @@index([category])
  @@index([isFeatured])
  @@index([slug])
  @@index([isPublished])
  @@index([marketPriceEnabled])
  @@index([isPublished, isFeatured])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING)
  customerEmail   String
  customerName    String
  shippingAddress Json
  subtotalCents   Int
  shippingCents   Int           @default(0)
  taxCents        Int           @default(0)
  discountCents   Int           @default(0)
  promoCode       String?
  totalCents      Int
  stripeSessionId String?       @unique
  stripePaymentId String?       @unique
  paymentStatus   PaymentStatus @default(UNPAID)
  trackingNumber  String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]

  @@index([customerEmail])
  @@index([status])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSku  String?
  quantity    Int
  priceCents  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // "percentage" or "fixed"
  discountValue Int       // percentage (e.g. 10 = 10%) or cents (e.g. 500 = $5.00)
  minOrderCents Int?      // minimum order amount to apply
  maxUses       Int?      // null = unlimited
  currentUses   Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("General Inquiry")
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

// Market Pricing

model SiteSettings {
  id                          String   @id @default("default")
  marketPriceMasterEnabled    Boolean  @default(false)
  marketPriceDefaultMarkup    Decimal  @default(0) @db.Decimal(5, 2)
  marketPriceDefaultCondition String   @default("Near Mint")
  marketPriceSyncFrequency    String   @default("24h")
  marketPriceShowBadge        Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
}

model MarketPriceSyncLog {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  totalProducts Int       @default(0)
  successCount  Int       @default(0)
  errorCount    Int       @default(0)
  errors        Json?
  apiCallsUsed  Int       @default(0)
  triggeredBy   String    @default("cron") // "cron", "manual", "single"

  @@index([startedAt])
}

model MarketPriceApiUsage {
  id                    String   @id @default("default")
  dailyCalls            Int      @default(0)
  monthlyCalls          Int      @default(0)
  dailyResetAt          DateTime @default(now())
  monthlyResetAt        DateTime @default(now())
  lastApiCallsRemaining Int?
  updatedAt             DateTime @updatedAt
}
